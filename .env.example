# Copy this file to .env.local and paste your Groq key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Optional — change models/voice without touching code
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus English voices, e.g.: troy, daniel, autumn (see the Groq playground for the full list)
GROQ_TTS_VOICE=troy
